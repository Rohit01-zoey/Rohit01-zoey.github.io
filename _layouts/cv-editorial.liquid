---
layout: default
---
{% assign cv = site.data.cv.cv %}
{% if page.cv_pdf contains '://' %}
  {% assign cv_pdf_url = page.cv_pdf %}
{% else %}
  {% assign cv_pdf_url = page.cv_pdf | relative_url %}
{% endif %}

<div class="post ed-cv">
  <header class="post-header">
    <h1 class="post-title">Curriculum Vitae</h1>
    {% if cv.summary %}<p class="post-description">{{ cv.summary }}</p>{% endif %}
  </header>

  <div class="ed-btns">
    {% if page.cv_pdf %}<a class="primary" href="{{ cv_pdf_url }}" target="_blank" rel="noopener">Download PDF &darr;</a>{% endif %}
    {% if cv.email %}<a href="mailto:{{ cv.email | encode_email }}">Email</a>{% endif %}
  </div>

  {% assign experience = cv.sections.Experience %}
  {% if experience %}
    <h2 class="section-label"><span>Experience</span></h2>
    {% for e in experience %}
      <div class="ed-cvrow">
        <span class="ed-date">{{ e.start_date }}{% if e.end_date %} – {{ e.end_date }}{% endif %}</span>
        <div>
          <div class="what">{{ e.position }}</div>
          <div class="where">
            {{ e.company }}
            {%- if e.summary %} · {{ e.summary | markdownify | remove: '<p>' | remove: '</p>' | strip }}{% endif %}
          </div>
          {% if e.highlights %}
            <ul class="hl">
              {% for h in e.highlights %}<li>{{ h | markdownify | remove: '<p>' | remove: '</p>' }}</li>{% endfor %}
            </ul>
          {% endif %}
        </div>
        <span class="side">{{ e.location }}</span>
      </div>
    {% endfor %}
  {% endif %}

  {% assign education = cv.sections.Education %}
  {% if education %}
    <h2 class="section-label"><span>Education</span></h2>
    {% for e in education %}
      <div class="ed-cvrow">
        <span class="ed-date">{{ e.start_date }}{% if e.end_date %} – {{ e.end_date }}{% endif %}</span>
        <div>
          <div class="what">{{ e.studyType }}{% if e.area %}, {{ e.area }}{% endif %}</div>
          <div class="where">
            {% if e.url %}<a href="{{ e.url }}">{{ e.institution }}</a>{% else %}{{ e.institution }}{% endif %}
          </div>
        </div>
        <span class="side">
          {%- if e.score %}{{ e.score }}<br>{% endif -%}
          {{ e.location }}
        </span>
      </div>
    {% endfor %}
  {% endif %}

  <h2 class="section-label">
    <span>Publications</span>
    {% if site.data.citations.metadata.total_citations %}
      <a href="{{ '/publications/' | relative_url }}"
        >{{ site.data.citations.metadata.total_citations }} citations · h-index {{ site.data.citations.metadata.h_index }} &rarr;</a
      >
    {% endif %}
  </h2>
  <div class="ed-cv-pubs">
    {% bibliography --group_by none --template bib_cv %}
  </div>

  {% for section in cv.sections %}
    {% assign title = section[0] %}
    {% unless title == 'Experience' or title == 'Education' %}
      <h2 class="section-label"><span>{{ title }}</span></h2>
      {% for e in section[1] %}
        <div class="ed-cvrow single">
          <div>
            {% if e.name %}
              <span class="what">{{ e.name }}</span>
              {%- if e.keywords %}: <span class="where">{{ e.keywords }}</span>{% endif %}
            {% elsif e.title %}
              <span class="what">{{ e.title }}</span>
              {%- if e.summary %} · <span class="where">{{ e.summary }}</span>{% endif %}
            {% else %}
              {{ e }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% endunless %}
  {% endfor %}
</div>
