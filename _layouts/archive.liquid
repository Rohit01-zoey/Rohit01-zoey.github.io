---
layout: default
---
<div class="post blog-index">
  <header class="post-header">
    {% assign n = page.documents | size %}
    {% if page.type == 'categories' %}
      <h1 class="post-title no-cap">{{ page.title }}</h1>
    {% elsif page.type == 'year' %}
      <h1 class="post-title">{{ page.date | date: '%Y' }}</h1>
    {% else %}
      <h1 class="post-title no-cap">#{{ page.title }}</h1>
    {% endif %}
    <p class="post-description">
      {{ n }} post{% if n != 1 %}s{% endif %} · <a href="{{ '/blog/' | relative_url }}">all posts</a>
    </p>
  </header>

  {% if page.type == 'tags' %}
    {% assign all_tags = site.tags | sort %}
    <nav class="ed-chips">
      <a href="{{ '/blog/' | relative_url }}">all</a>
      {% for tag in all_tags %}
        <a
          {% if tag[0] == page.title %}
            class="on"
          {% endif %}
          href="{{ tag[0] | slugify | prepend: '/blog/tag/' | relative_url }}"
        >
          {{- tag[0] -}}
        </a>
      {% endfor %}
    </nav>
  {% endif %}

  {% for post in page.documents %}
    {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
    {% if post.redirect == blank %}
      {% assign post_url = post.url | relative_url %}
    {% elsif post.redirect contains '://' %}
      {% assign post_url = post.redirect %}
    {% else %}
      {% assign post_url = post.redirect | relative_url %}
    {% endif %}
    <article class="ed-post">
      <span class="ed-date">{{ post.date | date: '%b %d, %Y' }} · {{ read_time }} min read</span>
      <h3><a href="{{ post_url }}">{{ post.title }}</a></h3>
      {% if post.description %}<p>{{ post.description }}</p>{% endif %}
      {% if post.tags.size > 0 %}
        <div class="ed-tags">
          {% for tag in post.tags %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">#{{ tag }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </article>
  {% endfor %}
</div>
