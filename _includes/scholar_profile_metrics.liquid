{% comment %}
  HTML must start at column 0 so Markdown (Kramdown) in _pages/*.md does not treat it as an indented code block.
{% endcomment %}
{% if site.data.citations and site.data.citations.metadata %}
{% assign sm = site.data.citations.metadata %}
{% if sm.total_citations != blank or sm.h_index != blank or sm.i10_index != blank %}
<div class="scholar-metrics">
{% if sm.total_citations != blank %}<div class="m"><b>{{ sm.total_citations }}</b><span>Citations</span></div>{% endif %}
{% if sm.h_index != blank %}<div class="m"><b>{{ sm.h_index }}</b><span>h-index</span></div>{% endif %}
{% if sm.i10_index != blank %}<div class="m"><b>{{ sm.i10_index }}</b><span>i10-index</span></div>{% endif %}
<div class="src">
{% if site.data.socials.scholar_userid %}<a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener noreferrer">Google Scholar &#8599;</a><br>{% endif %}
{% if sm.last_updated != blank %}updated {{ sm.last_updated | date: '%b %d, %Y' }}{% endif %}
</div>
</div>
{% endif %}
{% endif %}
